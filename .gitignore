.worktrees/
web/.tanstack/

# Go module/build caches (CI GOPATH/GOCACHE) — regenerated, not source
.go/
.gocache/

# Compiled binaries (go build -o server/crawler/import-crd/import-cmod) — regenerated, not source
/server
/crawler
/import-crd
/import-cmod

# Skill installs from `npx skills add` — local tooling, not project source
.agents/skills/

# Crawler screenshot output, saved locally as <dns_label>/<hostname>/*.png
# when running the crawler standalone (see CLAUDE.md). Named after whatever
# DNS servers are configured, so add new labels here as they show up.
Cloudflare_DoH/
Cloudflare_DoT/
Google_2/
Google_DoH_2/

# mTLS material generated by scripts/gen-mtls-certs.sh — private keys, never commit
certs/

# Per-host deployment secrets — copy from deployment/*/.env.example, never commit
deployment/*/.env

# Decrypted ansible-vault secrets — copy from the *.example file, encrypt before use, never commit plaintext
ansible/inventory/group_vars/*/vault.yml

# ansible-vault password file — never commit
ansible/.vault_pass

# Saved image tarballs from scripts/sync-staging-images.sh — regenerated, not source
*.tar.gz

# Personal spreadsheet dropped in repo root, not project source
Blocking Full List_1.xlsx
Blocking Full List_1.xlsx:Zone.Identifier
Masterlist Blocking CMOD.xlsx
Masterlist Blocking CMOD.xlsx:Zone.Identifier
ssl/*
