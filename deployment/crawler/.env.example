# Copy to .env and fill in — .env is gitignored, never commit real secrets.

# Optional: pin a specific tag instead of :main — for prod, pin to a
# release tag (:stable or :vX.Y.Z from the .gitlab-ci.yml release job)
# rather than tracking main.
CRAWLER_IMAGE=nssti-dev.mcmc.gov.my/nsrd/dns-compliance/crawler:main

# host:50051 of the dashboard this crawler reports to —
# staging: citadel-stg.mcmc.gov.my:50051
DASHBOARD_GRPC_ADDR=citadel-stg.mcmc.gov.my:50051

# Must match the dashboard host's CRAWLER_TOKEN exactly
CRAWLER_TOKEN=
