# Copy to .env and fill in — .env is gitignored, never commit real secrets.

# Optional: pin a specific tag instead of :main
SERVER_IMAGE=nssti-dev.mcmc.gov.my/nsrd/dns-compliance/server:main

DB_URL=host=... user=... password=... dbname=dns_compliance sslmode=disable
REDIS_ADDR=redis:6379
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=screenshots

# Must match the crawler host's CRAWLER_TOKEN exactly
CRAWLER_TOKEN=

# Only used on first boot against an empty `users` table — safe to leave set across redeploys
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
