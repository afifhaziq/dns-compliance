# Copy to .env and fill in — .env is gitignored, never commit real secrets.
# postgres/redis/minio run as containers in this same compose file — these
# credentials are what you're setting for those containers, not values to
# go fetch from somewhere else.

# Optional: pin a specific tag instead of :main — for prod, pin to a
# release tag (:stable or :vX.Y.Z from the .gitlab-ci.yml release job)
# rather than tracking main.
SERVER_IMAGE=nssti-dev.mcmc.gov.my/nsrd/dns-compliance/server:main
WEB_IMAGE=nssti-dev.mcmc.gov.my/nsrd/dns-compliance/web:main

# Public domain this dashboard is served on (Traefik Host() rules) —
# staging: citadel-stg.mcmc.gov.my / prod: citadel.mcmc.gov.my
DASHBOARD_DOMAIN=citadel-stg.mcmc.gov.my

# host:50052 of the crawler paired with this dashboard —
# staging: citadel-api.mcmc.gov.my:50052
CRAWLER_GRPC_ADDR=citadel-api.mcmc.gov.my:50052

POSTGRES_USER=dns_compliance
POSTGRES_PASSWORD=
POSTGRES_DB=dns_compliance

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Must match the crawler host's CRAWLER_TOKEN exactly
CRAWLER_TOKEN=

# Only used on first boot against an empty `users` table — safe to leave set across redeploys
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
