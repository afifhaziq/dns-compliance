// Hand-derived snapshot of the current PostgreSQL schema, sourced from the
// GORM models passed to AutoMigrate in internal/db/db.go and defined in
// internal/db/models.go. Not a build artifact — no generator keeps this in
// sync, so re-export by hand if those files change.
//
// Table names are GORM's default snake_case/pluralized names (schema.NamingStrategy),
// confirmed against raw SQL table/column references in internal/db/postgres.go
// and internal/db/legalcite.go.
//
// Regenerated 2026-08-13 against the full 25-table AutoMigrate list in
// internal/db/db.go (Department, User, Session, DNSServer, URL, DepartmentURL,
// ScanRun, ScanResult, CompliantIP, DomainWhois, IPInfo, Favicon, ScanSettings,
// SubdomainScan, ISPLogo, Instrument, Citation, Category, Element, SubElement,
// URLOffence, Agency, DueDatePreset, GridPreference, Notification) — adds the
// five-level legal citation catalog + URLOffence, Agency, DueDatePreset,
// GridPreference, and Notification tables that postdate the previous export,
// and moves urls' case-metadata columns off department_urls (see that table's
// Note below) to match the current models.go.
//
// Updated 2026-08-19: urls.reference_number/requesting_dept_id removed and
// replaced by the cases/case_letters/case_urls tables (28-table AutoMigrate
// list) — see urls' Note and the new tables below. Design history for this
// change: docs/db-schema-proposed.dbml (now shipped, kept for archaeology).

Table departments {
  id         integer   [pk, increment]
  name       varchar   [not null, unique, note: '"CMOD", "CRD", "Admin"']
  created_at timestamptz

  Note: 'Seeded by SeedDepartments if empty (CMOD/CRD/Admin).'
}

Table users {
  id                    integer   [pk, increment]
  username              varchar   [not null, unique]
  password_hash         varchar   [not null]
  is_admin              boolean   [not null, default: false]
  is_dept_admin         boolean   [not null, default: false]
  department_id         integer   [null, note: 'indexed']
  must_change_password  boolean   [not null, default: false]
  created_at            timestamptz

  Note: '''
    department_id required for every real user (incl. admins, who get the
    "Admin" department via MigrateAdminDepartments); nullable only because
    GORM needs it nullable to express the optional FK. is_admin and
    is_dept_admin are mutually exclusive.
  '''
}
Ref: users.department_id > departments.id

Table sessions {
  token      varchar   [pk, note: 'random session token, not auto-increment']
  user_id    integer   [not null, note: 'indexed']
  expires_at timestamptz [not null, note: 'indexed -- GetSession filters expires_at > now']
  created_at timestamptz
}
Ref: sessions.user_id > users.id

Table dns_servers {
  id         integer   [pk, increment]
  isp        varchar   [not null, default: 'Unknown']
  name       varchar   [not null]
  address    varchar   [not null]
  protocol   varchar   [not null, note: 'udp | dot | doh']
  enabled    boolean   [not null, default: true]
  created_at timestamptz
}

Table urls {
  id                  integer     [pk, increment]
  url                 varchar     [not null, unique, note: 'expected pre-normalized bare lowercase hostname, see internal/urlnorm']
  created_at          timestamptz
  due_date            timestamptz [null, note: 'takedown-order SLA deadline, carries time-of-day']
  agency_id           integer     [null, note: 'indexed, FK OnDelete:SET NULL']
  status              varchar     [note: '"" | requested | uplift | suspended, validated server-side -- independent of the derived Compliant field']
  requested_at        timestamptz [null]

  Note: '''
    Carries the domain's legal case metadata directly -- one case per
    domain, not one per watching department (two departments watching the
    same domain share the same takedown order), mirroring how
    DomainWhois/SubdomainScan/IPInfo are keyed by domain/IP rather than
    department. due_date/agency_id/status/requested_at originally lived on
    department_urls and were moved here the same day, before ever being
    deployed with real data -- see department_urls' Note. Editing them is
    visible to every department watching the domain (last-write-wins),
    gated by UpdateURLCaseFields' department-ownership check.

    reference_number and requesting_dept_id removed -- a url can carry many
    reference numbers over its history and a single reference number
    legitimately covers many urls (confirmed against real data: CRD's
    No. Rujukan NMD has 1,840 distinct values across 38,156 rows, one
    value alone covering 9,206 rows; 790 domains carry more than one
    distinct ref across their own history). A scalar column can only hold
    the last-imported one and silently discards the rest. Reference
    numbers and every other case-level attribute now live on cases,
    joined to urls many-to-many via case_urls.
  '''
}
Ref: urls.agency_id > agencies.id [delete: set null]

Table agencies {
  id         integer   [pk, increment]
  name       varchar   [not null, unique]
  created_at timestamptz

  Note: '''
    Admin-managed lookup table for the government agency behind a takedown
    request -- replaces an earlier free-text Agency column. Read open to any
    authenticated role; create/delete gated to admin-or-dept-admin, same
    shared/global-catalog pattern as dns_servers/isp_logos/the legal
    citation catalog.
  '''
}

Table due_date_presets {
  id         integer   [pk, increment]
  label      varchar   [not null]
  minutes    integer   [not null, note: 'renamed from hours (x60) by a one-time migration in db.Connect']
  created_at timestamptz

  Note: '''
    Admin/dept-admin-managed duration options in the watchlist's "Time to
    Block" picker -- e.g. Label "24 hours", Minutes 1440. Minute granularity
    (not just hours) lets a short preset (e.g. 2 minutes) exercise due-date
    notifications without waiting hours. Shared/global like Agency, not
    department-scoped. SeedDueDatePresets seeds the original hardcoded
    6h/24h/48h/72h/7-day options if empty. A preset can be deleted at any
    time without touching any url's already-set due_date -- purely a lookup
    read at selection time, never referenced back.
  '''
}

Table department_urls {
  department_id integer    [not null]
  url_id        integer    [not null]
  enabled       boolean    [not null, default: true]
  created_at    timestamptz

  indexes {
    (department_id, url_id) [pk]
  }

  Note: '''
    Composite PK, no surrogate id. Carries no case metadata -- that is
    global on urls now (see that table's Note); this table used to hold
    due_date/agency/reference_number/requesting_dept/status/requested_at
    columns, dropped by a one-time idempotent migration in db.Connect since
    nothing had shipped with real data on that shape yet. Removing a URL
    from a watchlist deletes only this row (RemoveFromWatchlist) -- never
    urls or scan_results, so scan history survives even once no department
    watches a domain. The OnDelete:CASCADE on url_id only fires via the
    admin-only PurgeURL path that deletes the urls row itself.
  '''
}
Ref: department_urls.department_id > departments.id
Ref: department_urls.url_id > urls.id [delete: cascade]

Table scan_runs {
  id           integer   [pk, increment]
  triggered_by varchar   [note: '"scheduled" | "manual" | "screenshot"']
  status       varchar   [note: '"running" | "completed" | "failed"']
  started_at   timestamptz
  completed_at timestamptz [null]
}

Table scan_results {
  id                   integer   [pk, increment]
  scan_run_id          integer   [not null, note: 'indexed']
  url_id               integer   [not null, note: 'indexed']
  url_value            varchar   [not null, note: '''
    Guaranteed equal to urls.url (normalized at write time in
    grpcServer.Submit; pre-existing rows repaired once by
    db.BackfillURLValues on startup). This is NOT just a denormalized
    display copy -- it is the GROUP BY / join key for nearly every
    aggregate query (ispStats, resurfacedDomains, trend/heatmap/uptime).
    Leading column of idx_scan_results_url_server_time.
  ''']
  dns_server_id        integer   [not null, note: 'indexed standalone + priority:2 in idx_scan_results_url_server_time']
  compliant            boolean   [not null, note: 'INVERTED: DNS resolves = violation (false), DNS fails = compliant (true)']
  resolved_ip          varchar
  resolved_ipv6        varchar
  resolved_asn         integer
  resolved_org         varchar
  resolved_netname     varchar
  resolved_abuse_email varchar
  screenshot_url       varchar
  error                varchar
  latency_ms           bigint    [default: 0, note: '0 = failed/unmeasured, excluded from ISP latency aggregates']
  scanned_at           timestamptz [note: '''
    Whole-second precision (time.Unix(r.Timestamp, 0)), not sub-second.
    Indexed standalone + priority:3 in idx_scan_results_url_server_time.
    Calendar-day bucketing elsewhere in the app (heatmap/trend/uptime) buckets
    this in Asia/Kuala_Lumpur (UTC+8), not UTC -- see postgres.go's
    reportingLocation.
  ''']

  indexes {
    (url_value, dns_server_id, scanned_at) [name: 'idx_scan_results_url_server_time', note: '''
      Column order matches the GROUP BY (url_value, dns_server_id) /
      MAX(scanned_at) shape used by ispStats and resurfacedDomains'
      latest-scan-per-(domain,server) subqueries -- do not reorder.
    ''']
  }
}
Ref: scan_results.scan_run_id > scan_runs.id
Ref: scan_results.url_id > urls.id [delete: cascade]
Ref: scan_results.dns_server_id > dns_servers.id [note: '''
  No FK-level cascade -- DeleteDNSServer manually deletes ScanResult rows in
  a transaction before deleting the server, per the model comment. This is
  deliberate, not a missed constraint.
''']

Table compliant_ips {
  id         integer   [pk, increment]
  address    varchar   [not null, unique]
  note       varchar
  created_at timestamptz

  Note: 'IPs treated as compliant even when DNS resolves, e.g. an ISP block-page IP (MCMC redirect).'
}

Table domain_whois {
  url_id                 integer   [pk, note: 'natural key, not surrogate -- one row per URL, 1:1']
  registrar               varchar
  registrar_url           varchar
  registrar_abuse_email   varchar
  registrar_abuse_phone   varchar
  domain_created          timestamptz [null]
  domain_expires          timestamptz [null]
  last_fetched_at         timestamptz [note: 'indexed']
  fetch_error             varchar

  Note: 'RDAP registration metadata. Absent row = never fetched. A failed re-fetch leaves stale fields in place rather than wiping them.'
}
Ref: domain_whois.url_id - urls.id

Table subdomain_scans {
  url_id      integer   [pk, note: 'natural key, 1:1']
  subdomains  jsonb     [note: '[]string via GORM json serializer']
  fetched_at  timestamptz
  fetch_error varchar

  Note: 'subfinder enumeration cache. No periodic refresh -- only re-run via explicit POST /api/subdomains/*url.'
}
Ref: subdomain_scans.url_id - urls.id

Table ip_infos {
  ip          varchar   [pk, note: 'the resolved IP itself, not a surrogate id']
  asn         integer
  org         varchar
  netname     varchar
  abuse_email varchar
  fetched_at  timestamptz
  fetch_error varchar

  Note: '''
    Keyed by IP, not domain or url_id -- deliberately NOT FK'd to any table.
    An IP's ASN/NetName is stable regardless of which domain currently
    resolves to it, so a distinct IP is looked up at most once, ever.
  '''
}

Table favicons {
  domain       varchar  [pk]
  content_type varchar
  data         bytea
  fetched_at   timestamptz
  fetch_error  varchar

  Note: '''
    Keyed by domain string, deliberately NOT FK'd to urls -- fetched at most
    once per domain ever, server-proxied so the target's logs never see a
    direct client request.
  '''
}

Table scan_settings {
  id               integer [pk, increment, note: 'single-row table -- app only ever writes ID 1']
  interval_minutes integer [not null]
  enabled          boolean [not null, default: false, note: 'automated scanning is an explicit admin opt-in']
  dns_workers      integer [not null, default: 100]

  Note: 'Seeded once from --interval on first boot (SeedScanInterval); the admin panel is authoritative after that.'
}

Table isp_logos {
  isp        varchar   [pk, note: 'ISP name itself, not a surrogate id']
  logo_url   varchar
  created_at timestamptz

  Note: '''
    Keyed by ISP name, deliberately NOT FK'd to dns_servers -- one ISP name
    is shared across multiple DNSServer rows (e.g. an ISP's DoT and UDP
    servers), so a DNSServer-level field would need cross-row sync. Purely
    cosmetic, never affects compliance calculations. Renaming/deleting an
    ISP via dns_servers does not cascade here -- orphaned rows are cleaned
    up manually.
  '''
}

Table grid_preferences {
  user_id           integer   [not null]
  grid_key          varchar   [not null]
  column_visibility jsonb     [note: 'map[string]bool via GORM json serializer']
  sort_field        varchar
  sort_desc         boolean
  page_size         integer
  updated_at        timestamptz

  indexes {
    (user_id, grid_key) [pk]
  }

  Note: '''
    One saved grid layout (column visibility, sort, page size) per
    (user, named grid) -- e.g. the watchlist grid vs the results grid each
    get their own row for the same user. OnDelete:CASCADE on user_id since a
    preference has no meaning once its owning user is gone.
  '''
}
Ref: grid_preferences.user_id > users.id [delete: cascade]

Table instruments {
  id           integer   [pk, increment]
  type         varchar   [not null, note: 'indexed -- ACT | ORDINANCE | ENACTMENT | SUBSIDIARY | CONSTITUTION']
  jurisdiction varchar   [not null, note: 'indexed -- FEDERAL, or a state name']
  number       varchar   [not null, default: '', note: '"588", "A1220", "No. 9 of 1995" -- always a string; may be empty, plenty of instruments have no commonly cited official number']
  year         integer   [null]
  short_title  varchar   [not null]
  created_at   timestamptz

  Note: '''
    A Malaysian law -- created/selected once via GetOrCreateInstrument on
    (type, jurisdiction, number, year) and reused, rather than re-entered
    per citation. Top of the five-level legal citation catalog:
    instruments -> citations -> categories -> elements -> sub_elements.
  '''
}

Table citations {
  id               integer   [pk, increment]
  instrument_id    integer   [not null, note: 'indexed']
  raw_text         varchar   [not null, note: 'exactly what the user typed -- source of truth/audit trail']
  parsed           jsonb     [note: 'LegalCitationParsed struct, a genuine jsonb column (not the plain-JSON-serializer pattern) so parsed->>\'key\' stays independently indexable']
  sort_key         varchar   [note: 'indexed, derived+zero-padded from parsed.provision_num+suffix, recomputed server-side on every write -- never client-supplied']
  parse_confidence varchar   [not null, default: 'NEEDS_REVIEW', note: 'OK | NEEDS_REVIEW, set by internal/legalcite.Parse']
  created_at       timestamptz

  Note: 'One specific provision cited under an Instrument, e.g. "Seksyen 233(1)(a)".'
}
Ref: citations.instrument_id > instruments.id [delete: cascade]

Table categories {
  id          integer   [pk, increment]
  citation_id integer   [not null, note: 'indexed']
  name        varchar   [not null]
  created_at  timestamptz

  Note: '''
    Scoped to one Citation, not a shared global lookup -- the same category
    name under two different citations is deliberately two separate rows,
    since category vocabulary is specific to the wording of the provision
    it is cited under.
  '''
}
Ref: categories.citation_id > citations.id [delete: cascade]

Table elements {
  id          integer   [pk, increment]
  category_id integer   [not null, note: 'indexed']
  name        varchar   [not null]
  created_at  timestamptz

  Note: 'Optional sub-category of a Category -- not every category has one.'
}
Ref: elements.category_id > categories.id [delete: cascade]

Table sub_elements {
  id         integer   [pk, increment]
  element_id integer   [not null, note: 'indexed']
  name       varchar   [not null]
  created_at timestamptz

  Note: 'Optional sub-category of an Element -- mirrors Element''s own relationship to Category one level up. Five levels is the ceiling, no nesting deeper.'
}
Ref: sub_elements.element_id > elements.id [delete: cascade]

Table url_offences {
  id             integer   [pk, increment]
  url_id         integer   [not null, note: 'indexed']
  category_id    integer   [not null, note: 'indexed']
  element_id     integer   [null, note: 'indexed']
  sub_element_id integer   [null, note: 'indexed']
  recorded_at    timestamptz [not null]

  Note: '''
    Links a URL to the specific offence it committed, at Category
    granularity with an optional Element and, one level deeper, an optional
    SubElement. Surrogate ID PK rather than composite (unlike
    department_urls) because element_id/sub_element_id are nullable and SQL
    NULL != NULL breaks composite-PK uniqueness.
  '''
}
Ref: url_offences.url_id > urls.id [delete: cascade]
Ref: url_offences.category_id > categories.id [delete: cascade]
Ref: url_offences.element_id > elements.id [delete: cascade]
Ref: url_offences.sub_element_id > sub_elements.id [delete: cascade]

Table cases {
  id            integer   [pk, increment]
  department_id integer   [not null, note: 'indexed -- which department this case came from']
  created_at    timestamptz

  Note: '''
    Thin anchor -- one row per real-world case/request, same role
    scan_runs already plays for scan_results. Every case fact (ref
    numbers, letters, subject, OIC, workflow status...) lives on
    case_letters, not here, since the sheet's real grain is one row per
    letter/document, not one row per case.
    UNRESOLVED CAVEAT: grouping CRD rows into a case at all assumes each
    distinct reference number is one real request -- CRD's
    "JK KPN(PR) 168/6" covering 9,206 rows suggests some values are a
    generic/fallback reference reused across unrelated entries, not a
    genuine single batch. See docs/cmod-blocking-list-migration-clarifications.md.
  '''
}
Ref: cases.department_id > departments.id

Table case_letters {
  id                integer     [pk, increment]
  case_id           integer     [not null, note: 'indexed']
  type              varchar     [not null, note: 'Memo | Notice | Memo (Uplift) | Notice (Uplift)']
  reference_number  varchar     [note: 'this letter\'s own citable ref -- CRD\'s No. Rujukan NMD row value, or CMOD\'s per-letter ref (memo and notice each get their own)']
  workflow_status   varchar     [note: 'CMOD-only internal approval state: Draft | Pending Legal | Pending TSC | Submitted, null for CRD-sourced letters']
  recipient         varchar     [note: 'CMOD "Recipient" column -- who the letter was sent to, same grain as requestor/subject (per letter, not per URL)']
  letter_date       timestamptz [null]
  received_at       timestamptz [null, note: 'CMOD "Received" column -- sparse/inconsistently formatted in the source sheet, same grain as submitted_at']
  submitted_at      timestamptz [null, note: 'CMOD Submission column -- sparse, ~387/499 filled']
  subject           varchar
  oic_user_id       integer     [null, note: 'officer in charge -- FK to users. NOT YET VERIFIED that OIC names in the source sheet (Atiqah, Arishah, ...) actually match real users.username values']
  requestor         varchar
  remarks           varchar
  created_at        timestamptz

  Note: '''
    One row per actual letter/document -- a case with a block + later
    uplift gets up to 4 rows here (Memo, Notice, Memo (Uplift),
    Notice (Uplift)), a CRD-sourced case typically gets 1. Mirrors the
    source sheet's real grain (one row per letter), which is what an
    earlier single-cases-row design collapsed away.

    CMOD BLK-sheet column placement decision (2026-08-19, see
    docs/cmod-blocking-list-migration-clarifications.md §6): of the four
    columns with no prior home, Recipient and Received are per-letter
    metadata and got new columns here. Offence and Agency are NOT new
    columns anywhere -- they already have a home on urls/url_offences
    (Offence maps to the existing url_offences.category_id catalog per
    URL in the case; Agency maps to the existing urls.agency_id FK), so
    the importer links through those tables instead of duplicating the
    data here. Offence/Agency import wiring is deferred pending the
    still-open category/offence-splitting sign-off (compound values like
    "Palsu, Jelik Melampau") -- a separate question from where the column
    lives.
  '''
}
Ref: case_letters.case_id > cases.id [delete: cascade]
Ref: case_letters.oic_user_id > users.id [delete: set null]

Table case_urls {
  case_id integer [not null]
  url_id  integer [not null]
  phase   varchar [not null, note: 'requested | uplift | suspended -- this (case, url) pair\'s own outcome, same vocabulary urls.status carries']

  indexes {
    (case_id, url_id) [pk]
  }

  Note: '''
    Many-to-many join -- one case lists every url it covers (e.g. CMOD's
    "10 URLs in one Notice"); one url can belong to many cases over time
    (reblocked under a new reference). Carries its own `phase` rather than
    being a plain junction row: confirmed some urls within the same case
    reach a different outcome than their siblings (2/65 CMOD cases, 96/1841
    CRD ref-no groups have mixed status across their own urls -- e.g. CMOD
    case 19 covers 16 domains, only capitalpost.com.my was ever uplifted).
    phase stays here rather than on case_letters because it varies per url
    within the same case, not per letter. Sole source of truth for the
    url<->reference-number relationship now that urls.reference_number is
    removed. "Current" reference/status for display is derived by querying
    the most recent case_letters row for the case (via letter_date) joined
    through case_urls, not stored as a scalar on urls.

    db.Store.AddURLToCase (POST /api/cases/{id}/urls) inserts additional
    rows here directly, for building the "N URLs in one Notice" shape --
    CreateCase itself still only ever links the one url a case is opened
    for.
  '''
}
Ref: case_urls.case_id > cases.id [delete: cascade]
Ref: case_urls.url_id > urls.id [delete: cascade]

Table notifications {
  id            integer     [pk, increment]
  department_id integer     [not null, note: 'priority:1 in idx_notifications_dept_read']
  url_id        integer     [not null, note: 'indexed']
  url_value     varchar     [not null, note: 'indexed -- denormalized read/query key so list/dedup queries skip a join']
  type          varchar     [not null, note: '"resurfaced" | "due_date_reached"']
  compliant     boolean     [null, note: 'always nil for resurfaced (the type is the signal), always set for due_date_reached']
  details       jsonb       [note: 'map[string]any via GORM json serializer -- e.g. resurfaced\'s affected-server list']
  scan_run_id   integer     [null, note: 'set only for due_date_reached (one Trigger call = one ScanRun)']
  scanned_at    timestamptz [null, note: 'always set -- for resurfaced this is the flip time, which can span scan runs so scan_run_id is left null']
  read_at       timestamptz [null, note: 'priority:2 in idx_notifications_dept_read']
  created_at    timestamptz [note: 'indexed']

  indexes {
    (department_id, read_at) [name: 'idx_notifications_dept_read']
  }

  Note: 'A queued alert for a department about a domain event -- a resurfaced (compliant->violating) regression, or a due-date scan outcome.'
}
Ref: notifications.url_id > urls.id [delete: cascade]
